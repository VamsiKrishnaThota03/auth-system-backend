# MySQL connection string used by Prisma
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/auth_system
# Random string of at least 16 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# Optional
PORT=3000
JWT_EXPIRES_IN=24h
# Comma-separated list of allowed browser origins (unset = any origin)
CORS_ORIGIN=
# Login/signup attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
