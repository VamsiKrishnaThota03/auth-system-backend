{
  "name": "auth-system-backend",
  "version": "1.0.0",
  "description": "Authentication system backend with Node.js, Express, TypeScript, and MySQL",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "test": "jest"
  },
  "keywords": [
    "authentication",
    "typescript",
    "express",
    "mysql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.5",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.1",
    "prisma": "^5.0.0",
    "typescript": "^5.1.6",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/supertest": "^7.2.1",
    "jest": "^29.6.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
